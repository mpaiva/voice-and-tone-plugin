{
  "name": "figma-clearcopy",
  "version": "0.1.0",
  "description": "A Figma plugin that analyzes text against voice and tone guidelines for accessibility and plain language",
  "main": "dist/code.js",
  "scripts": {
    "build": "npm run build:code && npm run build:ui",
    "build:code": "vite build --mode code",
    "build:ui": "vite build",
    "watch": "npm run build && npm run watch:ui",
    "watch:ui": "vite build --watch",
    "dev": "npm run watch"
  },
  "keywords": [
    "figma",
    "plugin",
    "accessibility",
    "plain-language",
    "voice-and-tone"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tabler/icons-react": "^3.35.0",
    "compromise": "^14.14.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "text-readability": "^1.1.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.98.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.2",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
