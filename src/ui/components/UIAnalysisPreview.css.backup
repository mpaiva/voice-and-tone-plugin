.ui-analysis-preview {
  margin-top: 16px;
  padding: 16px;
  background: #f8f9fa;
  border-radius: 8px;
}

.preview-header {
  margin-bottom: 16px;
}

.preview-header h4 {
  margin: 0 0 4px 0;
  font-size: 16px;
  font-weight: 600;
  color: #1a1a1a;
}

.preview-description {
  margin: 0;
  font-size: 13px;
  color: #666;
}

.layout-info {
  margin-bottom: 12px;
}

.layout-badge {
  display: inline-block;
  padding: 6px 12px;
  background: #e3f2fd;
  color: #1976d2;
  border-radius: 4px;
  font-size: 12px;
}

.component-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 16px;
  max-height: 300px;
  overflow-y: auto;
}

.component-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px;
  background: white;
  border-radius: 6px;
  border: 1px solid #e0e0e0;
}

.component-item.component-heading {
  border-left: 3px solid #673ab7;
}

.component-item.component-text {
  border-left: 3px solid #757575;
}

.component-item.component-button {
  border-left: 3px solid #2196f3;
}

.component-item.component-container {
  border-left: 3px solid #ff9800;
}

.component-item.component-icon {
  border-left: 3px solid #00bcd4;
}

.component-item.component-link {
  border-left: 3px solid #9c27b0;
}

.component-icon {
  font-size: 20px;
  flex-shrink: 0;
}

.component-details {
  flex: 1;
  min-width: 0;
}

.component-type-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  color: #666;
  letter-spacing: 0.5px;
  margin-bottom: 4px;
}

.component-text {
  font-size: 14px;
  color: #1a1a1a;
  margin-bottom: 4px;
  word-break: break-word;
}

.component-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.meta-item {
  font-size: 11px;
  color: #888;
  background: #f5f5f5;
  padding: 2px 6px;
  border-radius: 3px;
}

.meta-item.font-weight {
  background: #e3f2fd;
  color: #1976d2;
  font-weight: 500;
}

.meta-item.link-badge {
  background: #f3e5f5;
  color: #7b1fa2;
  font-weight: 500;
}

.meta-item.position-badge {
  background: #fff3e0;
  color: #e65100;
  font-weight: 500;
}

.component-colors {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}

.color-swatch {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: #666;
}

.color-chip {
  width: 16px;
  height: 16px;
  border-radius: 3px;
  border: 1px solid #ddd;
  flex-shrink: 0;
}

.no-components {
  padding: 32px 16px;
  text-align: center;
  color: #666;
}

.no-components p {
  margin: 0 0 8px 0;
}

.help-text {
  font-size: 12px;
  color: #999;
}

.preview-cost {
  padding: 8px 12px;
  background: #fff3e0;
  border-radius: 4px;
  margin-bottom: 16px;
}

.preview-cost p {
  margin: 0;
  font-size: 12px;
  color: #e65100;
}

.preview-actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
}

.btn-secondary {
  padding: 8px 16px;
  background: white;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-secondary:hover {
  background: #f5f5f5;
}

.btn-primary {
  padding: 8px 16px;
  background: #2196f3;
  color: white;
  border: none;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-primary:hover:not(:disabled) {
  background: #1976d2;
}

.btn-primary:disabled {
  background: #ccc;
  cursor: not-allowed;
}
