.settings-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.settings-modal {
  background: #fff;
  border-radius: 8px;
  width: 90%;
  max-width: 500px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

.settings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid #e5e7eb;
}

.settings-header h2 {
  margin: 0;
  font-size: 18px;
  font-weight: 600;
  color: #111827;
}

.close-btn {
  background: none;
  border: none;
  font-size: 24px;
  color: #6b7280;
  cursor: pointer;
  padding: 0;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
}

.close-btn:hover {
  background: #f3f4f6;
}

.settings-content {
  padding: 20px;
  overflow-y: auto;
  flex: 1;
}

.setting-group {
  margin-bottom: 24px;
}

.setting-label {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  color: #111827;
}

.setting-label input[type="checkbox"] {
  width: 18px;
  height: 18px;
  cursor: pointer;
}

.setting-label-text {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #111827;
  margin-bottom: 8px;
}

.setting-help {
  margin: 6px 0 0 0;
  font-size: 12px;
  color: #6b7280;
  line-height: 1.5;
}

.setting-help a {
  color: #3b82f6;
  text-decoration: none;
}

.setting-help a:hover {
  text-decoration: underline;
}

.api-key-input {
  display: flex;
  gap: 8px;
}

.api-key-input input {
  flex: 1;
  padding: 8px 12px;
  border: 1px solid #d1d5db;
  border-radius: 4px;
  font-size: 14px;
  font-family: monospace;
}

.api-key-input input:disabled {
  background: #f3f4f6;
  color: #9ca3af;
}

.api-key-input input:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.toggle-visibility {
  padding: 8px 12px;
  background: #f3f4f6;
  border: 1px solid #d1d5db;
  border-radius: 4px;
  cursor: pointer;
  font-size: 16px;
}

.toggle-visibility:hover:not(:disabled) {
  background: #e5e7eb;
}

.toggle-visibility:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.setting-group select {
  width: 100%;
  padding: 8px 12px;
  border: 1px solid #d1d5db;
  border-radius: 4px;
  font-size: 14px;
  background: #fff;
}

.setting-group select:disabled {
  background: #f3f4f6;
  color: #9ca3af;
}

.setting-group select:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.settings-error {
  padding: 12px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 4px;
  color: #991b1b;
  font-size: 13px;
  margin-top: 16px;
}

.settings-info {
  margin-top: 24px;
  padding: 16px;
  background: #eff6ff;
  border: 1px solid #dbeafe;
  border-radius: 4px;
}

.settings-info h3 {
  margin: 0 0 12px 0;
  font-size: 14px;
  font-weight: 600;
  color: #1e40af;
}

.settings-info ul {
  margin: 0;
  padding-left: 20px;
}

.settings-info li {
  font-size: 12px;
  color: #1e40af;
  margin-bottom: 6px;
  line-height: 1.5;
}

.settings-footer {
  padding: 16px 20px;
  border-top: 1px solid #e5e7eb;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

.btn-primary,
.btn-secondary {
  padding: 8px 16px;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  border: none;
}

.btn-primary {
  background: #3b82f6;
  color: #fff;
}

.btn-primary:hover {
  background: #2563eb;
}

.btn-secondary {
  background: #fff;
  color: #374151;
  border: 1px solid #d1d5db;
}

.btn-secondary:hover {
  background: #f9fafb;
}

.btn-toggle-guidelines {
  padding: 4px 12px;
  background: #fff;
  border: 1px solid #d1d5db;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  color: #374151;
  transition: background 0.2s, border-color 0.2s;
}

.btn-toggle-guidelines:hover:not(:disabled) {
  background: #f9fafb;
  border-color: #9ca3af;
}

.btn-toggle-guidelines:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.guidelines-textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #d1d5db;
  border-radius: 4px;
  font-size: 13px;
  font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
  line-height: 1.6;
  resize: vertical;
  margin-top: 8px;
  background: #fff;
}

.guidelines-textarea:disabled {
  background: #f3f4f6;
  color: #9ca3af;
}

.guidelines-textarea:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.guidelines-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  margin-top: 8px;
}

.character-count {
  margin: 0;
  font-size: 12px;
  color: #6b7280;
  font-family: monospace;
  white-space: nowrap;
  flex-shrink: 0;
}

.character-count.warning {
  color: #f59e0b;
  font-weight: 600;
}

/* Settings Divider */
.settings-divider {
  height: 2px;
  background: linear-gradient(90deg, #e5e7eb 0%, #8b5cf6 50%, #e5e7eb 100%);
  margin: 32px 0;
  border: none;
}

/* Button Groups */
.button-group {
  display: flex;
  gap: 6px;
  align-items: center;
}

.btn-load-defaults,
.btn-load-defaults-small {
  padding: 4px 12px;
  background: #8b5cf6;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-load-defaults:hover:not(:disabled),
.btn-load-defaults-small:hover:not(:disabled) {
  background: #7c3aed;
}

.btn-load-defaults:disabled,
.btn-load-defaults-small:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-load-defaults-small {
  padding: 6px 12px;
  font-size: 12px;
}

.guidelines-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

/* Copywriting Guidelines Specific */
.copywriting-guidelines {
  background: #faf5ff;
  border-color: #8b5cf6;
}

.copywriting-guidelines:focus {
  border-color: #7c3aed;
  box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
}

.copywriting-guidelines:disabled {
  background: #f3f4f6;
  color: #9ca3af;
}
